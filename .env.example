# No variable is required for deterministic execution or tests.
# Backend storage (optional override; default shown)
DATABASE_URL=sqlite:///./data/agentic_supportops.db

# Optional OpenAI-backed investigation runtimes
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_RETRIES=0
OPENAI_TIMEOUT_SECONDS=60
AI_MAX_RESPONSE_ITERATIONS=8
AI_MAX_TOOL_CALLS=16
AI_MAX_IDENTICAL_TOOL_CALLS=2
AI_MAX_OUTPUT_TOKENS=2000

# Tool transport: direct (default) or local MCP stdio
TOOL_TRANSPORT=direct
MCP_TIMEOUT_SECONDS=10

# Explicit recovery threshold for an interrupted read-only reconciliation
ACTION_EXECUTION_RECONCILIATION_STALE_AFTER_SECONDS=300

# Optional application-owned OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agentic-supportops
OTEL_EXPORTER=none

# Frontend development API location
VITE_API_BASE_URL=http://localhost:8000
